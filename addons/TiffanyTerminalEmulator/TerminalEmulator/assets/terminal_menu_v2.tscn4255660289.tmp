[sub_resource type="GDScript" id="GDScript_6h83f"]
script/source = "extends TextEdit

@onready var text_edit = self
var PREFIX := \"I AM AWESOME \\n YES \\n mmmh mmh\"

var _prefix_lines: PackedStringArray

func _ready():
	_prefix_lines = PREFIX.split(\"\\n\", false)
	if _prefix_lines.is_empty():
		_prefix_lines.append(\"\")

	text_edit.text = PREFIX
	_set_caret_to_end_of_prefix()

func _gui_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed:
		var caret_in_prefix = _is_inside_prefix(
			get_caret_line(), get_caret_column()
		)

		var selection_hits_prefix = _selection_touches_prefix()

		if event.keycode == KEY_BACKSPACE || event.keycode == KEY_DELETE:
			var line := get_caret_line()
			var col := get_caret_column()

			# If we're exactly at the prefix boundary → block
			if line == _prefix_lines.size() - 1 and col == _prefix_lines[-1].length():
				accept_event()
				return

			# If inside prefix → block
			if _is_inside_prefix(line, col) or _selection_touches_prefix():
				accept_event()
				return

		# --- BLOCK typing characters ---
		if event.unicode != 0:
			if caret_in_prefix or selection_hits_prefix:
				accept_event()
				return

		# --- ENTER: only block if caret is in prefix ---
		if event.keycode in [KEY_ENTER, KEY_KP_ENTER]:
			if caret_in_prefix:
				accept_event()
				return
				
		if event.keycode in [KEY_ENTER, KEY_KP_ENTER]:
			_handle_enter(event)
	if not (event is InputEventMouse) and not has_selection():
		_clamp_caret()

func _clamp_caret():
	# Allow caret anywhere while selecting
	if has_selection():
		return

	# Otherwise enforce prefix lock
	if _is_inside_prefix(get_caret_line(), get_caret_column()):
		_set_caret_to_end_of_prefix()

func _is_inside_prefix(line: int, col: int) -> bool:
	if line < _prefix_lines.size() - 1:
		return true
	
	if line == _prefix_lines.size() - 1:
		return col < _prefix_lines[-1].length()
	
	return false

func _selection_touches_prefix() -> bool:
	if not has_selection():
		return false

	var from_line := get_selection_from_line()
	var from_col := get_selection_from_column()
	var to_line := get_selection_to_line()
	var to_col := get_selection_to_column()

	# Normalize order
	if (to_line < from_line) or (to_line == from_line and to_col < from_col):
		var tl = from_line
		var tc = from_col
		from_line = to_line
		from_col = to_col
		to_line = tl
		to_col = tc

	# If selection starts inside prefix → blocked
	if _is_inside_prefix(from_line, from_col):
		return true

	return false

func _set_caret_to_end_of_prefix():
	var last_line := _prefix_lines.size() - 1
	var last_col := _prefix_lines[last_line].length()
	set_caret_line(last_line)
	set_caret_column(last_col)

func add(statement: String):
	text += statement
	set_caret_line(get_line_count() - 1)
	set_caret_column(get_line(get_line_count() - 1).length())

func _on_text_changed():
	if not text.begins_with(PREFIX):
		var user_text := text.substr(PREFIX.length())
		text = PREFIX + user_text
		_set_caret_to_end_of_prefix()

func _handle_enter(event: InputEventKey) -> void:
	# Let Godot insert newline first
	call_deferred(\"_after_enter\")

func _after_enter():
	# Let Godot finish inserting newline first
	await get_tree().process_frame

	var line := get_caret_line()
	var col := get_caret_column()

	# If somehow inside prefix, fix it
	if _is_inside_prefix(line, col):
		_set_caret_to_end_of_prefix()
	else:
		# Force caret refresh (THIS fixes invisibility)
		set_caret_line(line)
		set_caret_column(col)

	# Optional: ensure visibility
	scroll_vertical = get_caret_line()
"

