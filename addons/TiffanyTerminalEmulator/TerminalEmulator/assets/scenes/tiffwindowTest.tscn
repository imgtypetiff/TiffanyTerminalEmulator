script/source = "extends Node

var scene: PackedScene = preload(\"res://addons/TifunixSystems/TifunixTerminal/assets/scenes/Terminal.tscn\")
@onready var window: tiffwindow =  $\"../ControlNodeWindowTemplate\"

func _ready() -> void:
	await window.__is_ready == true
	window.add_child(scene.instantiate())
	queue_free()
"

